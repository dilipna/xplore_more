# Zero-service recorded edition is the default, including when no env file exists.
XM_WEB_MODE=recorded
# For the full LOCAL backend, explicitly set XM_WEB_MODE=connected and its API URL.
XM_API_URL=http://127.0.0.1:8767
# Optional backend API key, server-side only. No key is needed for the recorded edition.
XM_API_KEY=
