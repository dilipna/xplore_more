# Copy to .env for local development. Never commit .env.
XM_ENV=dev
XM_DATABASE_URL=postgresql+psycopg://xm:xm@localhost:5432/xploremore
XM_GCP_PROJECT=xm-local
# Point Google client libraries at the local emulator:
PUBSUB_EMULATOR_HOST=localhost:8085
# API protection (Upstash rediss:// in prod). Anonymous callers get this per-IP rate.
XM_REDIS_URL=redis://localhost:6379/0
XM_ANON_RATE_PER_MINUTE=30
XM_REQUIRE_API_KEY_FOR_PROBLEMS=false
# Discussion sources (poller): stable salt for author_hash (>= 16 chars, Secret Manager in prod)
XM_AUTHOR_SALT=
# Optional: raises GitHub search quota from 10 to 30 requests/minute
GITHUB_TOKEN=
# MCP server (apps/mcp): thin client of the REST API
XM_API_URL=http://127.0.0.1:8000
XM_API_KEY=
