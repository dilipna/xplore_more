# Normalize line endings: containers, shell scripts and Go tooling expect LF.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gz binary
*.onnx binary

# Public capture checksums must survive Windows/Linux checkouts unchanged.
apps/web/src/data/demo-snapshot*.json text eol=lf
apps/web/public/capture-data/*.json text eol=lf
