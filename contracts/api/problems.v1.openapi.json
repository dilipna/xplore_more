  "info": {
    "description": "Clustered, evidence-backed, demand-ranked problems. Additive changes only within v1. Compact responses for agent tool use.",
    "title": "XploreMore Problems API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/problems": {
      "get": {
        "description": "Problems clustered from discussions (Hacker News, GitHub issues, Lobsters, Stack Exchange), ranked by demand. With `topic`, problems are retrieved by hybrid search over their evidence, filtered to relevance >= 0.5 and ranked by relevance x sqrt(demand). Responses are compact for agent tool use.",
        "operationId": "problems_v1_problems_get",
        "parameters": [
          {
            "in": "query",
            "name": "topic",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Topic"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "bug_or_reliability",
                    "cost_or_performance",
                    "missing_capability",
                    "workflow_friction"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "since_days",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 90,
              "minimum": 1,
              "title": "Since Days",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "min_voices",
            "required": false,
            "schema": {
              "default": 2,
              "maximum": 100,
              "minimum": 1,
              "title": "Min Voices",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 25,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Evidence items per problem.",
            "in": "query",
            "name": "evidence",
            "required": false,
            "schema": {
              "default": 3,
              "description": "Evidence items per problem.",
              "maximum": 5,
              "minimum": 0,
              "title": "Evidence",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or revoked API key, or key required by deployment"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "ApiKey": []
          }
        ],
        "summary": "Ranked, evidence-backed problems people report",
        "tags": [
          "problems"
        ]
      }
    },
    "/v1/problems/{problem_id}": {
      "get": {
        "operationId": "problem_v1_problems__problem_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "problem_id",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Problem Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "evidence",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 25,
              "minimum": 1,
              "title": "Evidence",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or revoked API key, or key required by deployment"
          },
          "404": {
            "description": "Problem not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "ApiKey": []
          }
        ],
        "summary": "One problem with full evidence and demand factors",
        "tags": [
          "problems"
        ]
      }
    }
  }
}
